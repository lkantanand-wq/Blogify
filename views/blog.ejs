<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('./partials/head') %>
        <title>Blog</title>
</head>

<body>

    <%- include('./partials/nav') %>
        <div class="container mt-3">
            <h1>
                <%= blog.title %>
            </h1>
            <img src="<%= blog.coverImageUrl %>" width="600px" alt="Cover Image" class="img-fluid">
            <p class="mt-3">
                <%= blog.body %>
            </p>
            <% if (user && blog.createdBy._id.toString() === user._id) { %>
              <div class="mb-4">
                <form action="/blog/delete/<%= blog._id %>" method="post" class="d-inline">
                  <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this blog?');">Delete</button>
                </form>
              </div>
            <% } %>
            <div class="container mt-3">
                <img src="<%= blog.createdBy.profilePic%>" width="50px" height="50px" class="rounded-circle">
                <span class="ms-2">
                    <%= blog.createdBy.fullName %>
                </span>
            </div>
            <div class="container mt-3">
                <h2>Comments (<%= comments.length %>)</h2>
                <% if (locals.user) { %>
                    <div class="container mt-4">
                        <form action="/blog/comment/<%= blog._id %>" method="post">
                            <div class="mb-3">
                                <input type="text" class="form-control" name="content" placeholder="Add a comment...">
                            </div>
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </form>
                    </div>
                    <% } %>
                        <div class="mt-3">
                            <% comments.forEach(comment=> { %>
                                <div>
                                    <img src="<%= comment.createdBy.profilePic%>" width="50px" height="50px"
                                        class="rounded-circle">
                                    <%= comment.createdBy.fullName %>
                                        <p>
                                            <%= comment.content %>
                                        </p>
                                </div>
                        </div>
                        <% }) %>
            </div>
            <%- include('./partials/scripts') %>
</body>

</html>